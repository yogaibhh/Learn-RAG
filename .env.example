# --- Embedding ---------------------------------------------------------------
# Jina AI v5. Key gratis tanpa kartu kredit: https://jina.ai/?sui=apikey
# Kalau dikosongkan: pakai `--embedder local` (model di mesin sendiri) atau
# `--embedder none` (tanpa vektor, pencarian BM25 saja).
JINA_API_KEY=

# --- Generation --------------------------------------------------------------
# Groq. Key gratis: https://console.groq.com/keys
# Ini jalur bawaan karena gratis.
GROQ_API_KEY=

# Claude. Opsional, alternatif Groq dengan sitasi tingkat karakter.
# Dipakai kalau GROQ_API_KEY kosong, atau dipaksa lewat --provider claude.
ANTHROPIC_API_KEY=
